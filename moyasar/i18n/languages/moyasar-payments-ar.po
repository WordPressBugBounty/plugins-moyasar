msgstr "رمز التحقق (CVC)"

# New Translations
msgid "Save to account"
msgstr "حفظ البطاقة في حسابي"

msgid "Mobile Number"
msgstr "رقم الجوال"

msgid "Pay with STC Pay"
msgstr "ادفع باستخدام اس تي سي باي"

msgid "Enable Apple Pay on Product Page"
msgstr "تفعيل Apple Pay في صفحة المنتج"

msgid "Show the Apple Pay button on individual product pages."
msgstr "إظهار زر Apple Pay في صفحات المنتجات الفردية."

msgid "Accept Credit/Debit Cards, Apple Pay, and more."
msgstr "اقبل الدفع بالبطاقات الائتمانية، أبل باي، والمزيد."

# Invoice Gateway
msgid "Moyasar Default (invoice)"
msgstr "ميسر (الفاتورة)"

msgid "Moyasar Invoice"
msgstr "فاتورة ميسر"

msgid "Pay by Invoice"
msgstr "الدفع بالفاتورة"

msgid "Redirect customers to a secure Moyasar payment page to pay with card, Apple Pay, or other methods. Works with all themes and as a fallback when embedded checkout is unavailable."
msgstr "توجيه العملاء إلى صفحة دفع ميسر الآمنة للدفع بالبطاقة أو أبل باي أو غيرها. يعمل مع جميع القوالب وكخيار بديل عند عدم توفر الدفع المضمن."

msgid "Invoice"
msgstr "الفاتورة"

msgid "Redirect customers to a secure Moyasar payment page. Supports cards, Apple Pay, and more. Works with all themes and as a fallback when embedded checkout is unavailable."
msgstr "توجيه العملاء إلى صفحة دفع ميسر الآمنة. يدعم البطاقات وأبل باي والمزيد. يعمل مع جميع القوالب وكخيار بديل عند عدم توفر الدفع المضمن."

